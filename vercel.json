{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/salud.js": {
      "maxDuration": 15
    },
    "api/texto.js": {
      "maxDuration": 60
    },
    "api/proyectos.js": {
      "maxDuration": 30
    },
    "api/imagen.js": {
      "maxDuration": 60
    },
    "api/urls.js": {
      "maxDuration": 30
    },
    "api/video-inicio.js": {
      "maxDuration": 60
    },
    "api/video-estado.js": {
      "maxDuration": 30
    },
    "api/voz.js": {
      "maxDuration": 60
    },
    "api/musica.js": {
      "maxDuration": 300
    },
    "api/transcripcion.js": {
      "maxDuration": 30
    },
    "api/montaje.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
